# --- FarmShield AI backend (copy to .env) ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./farmshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather source: mock (replays data/sample_readings.json) or conduit (JKUAT Conduit station)
WEATHER_PROVIDER=mock
CONDUIT_API_URL=
CONDUIT_API_KEY=
DEFAULT_SCENARIO=normal

# Gemini - advice text only (scoring is rule-based). Do NOT use gemini-flash-latest (429 quota).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Africa's Talking sandbox SMS
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_SENDER=console

# --- Frontend (frontend/.env) ---
# VITE_API_URL=http://localhost:8000
