# --- FarmShield AI backend (copy to .env) ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./farmshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather source:
#   conduit_api - live Conduit@Empathy API (needs key + email; falls back to conduit_csv on any failure)
#   conduit_csv - station export in backend/data/conduit_daily.csv (default; falls back to scenario if missing)
#   scenario    - synthetic demo scenarios only (normal / dry_spell / heavy_rain)
WEATHER_PROVIDER=conduit_csv
CONDUIT_API_URL=https://conduit.jhubafrica.com/data.php
CONDUIT_API_KEY=
CONDUIT_EMAIL=
CONDUIT_DAILY_CSV=data/conduit_daily.csv
CONDUIT_RAW_CSV=data/conduit_raw.csv
CONDUIT_CACHE_DIR=data/cache
CONDUIT_CACHE_TTL_MIN=15
DEFAULT_SCENARIO=normal

# Gemini - advice text only (scoring is rule-based). Do NOT use gemini-flash-latest (429 quota).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Africa's Talking sandbox SMS
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_SENDER=console

# Alerts: lowest overall level that warrants an SMS, and the no-repeat window (unless the level changes)
ALERT_MIN_LEVEL=MEDIUM
ALERT_DEDUPE_HOURS=6

# --- Frontend (frontend/.env) ---
# VITE_API_URL=http://localhost:8000
